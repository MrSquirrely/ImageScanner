<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AssemblyTitle>PixShelf</AssemblyTitle>
		<Product>PixShelf</Product>
		<Version>1.0.0</Version>
		<ApplicationIcon>Assets\PixShelf.ico</ApplicationIcon>
		<SixLaborsLicenseFile Condition="Exists('..\sixlabors.lic')">..\sixlabors.lic</SixLaborsLicenseFile>
		<!-- Where build\Plugin.targets copies bundled plugins. It has no runtime identifier in it, so a self-contained
		     publish (bin\...\win-x64\) still finds them here. -->
		<BundledPluginsDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\Plugins\</BundledPluginsDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="HandyControls" Version="3.7.0" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\PixShelf.ico" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ImageScanner.Core\ImageScanner.Core.csproj" />
		<ProjectReference Include="..\ImageScanner.Plugins.Abstractions\ImageScanner.Plugins.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Bundled plugins: built first so they land in bin\...\Plugins, but never referenced by the app itself -->
		<!-- Plugins always build framework-dependent: a self-contained publish of the app mustn't copy the runtime into them -->
		<ProjectReference Include="..\ImageScanner.Plugins.LocalTagger\ImageScanner.Plugins.LocalTagger.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
		<ProjectReference Include="..\ImageScanner.Plugins.Claude\ImageScanner.Plugins.Claude.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
		<!-- The duplicate finder and batch converter are download only (PluginDistribution=Marketplace), so they aren't listed here -->

	</ItemGroup>

	<!--
	  Official plugins: the SHA-256 of each bundled plugin's entry assembly (Plugins\<Name>\<Name>.dll, built above)
	  is compiled into the app. At runtime a plugin is shown as official only if its file matches one of these
	  hashes, so a third-party or modified DLL can't claim to be official by name or author.
	-->
	<Target Name="GenerateOfficialPluginHashes" AfterTargets="ResolveProjectReferences" BeforeTargets="CoreCompile">
		<ItemGroup>
			<_BundledPluginFolder Include="$([System.IO.Directory]::GetDirectories('$(BundledPluginsDir)'))" Condition="Exists('$(BundledPluginsDir)')" />
			<_BundledPluginAssembly Include="@(_BundledPluginFolder->'%(FullPath)\%(Filename)%(Extension).dll')" />
			<_BundledPluginAssembly Remove="@(_BundledPluginAssembly)" Condition="!Exists('%(FullPath)')" />
		</ItemGroup>
		<GetFileHash Files="@(_BundledPluginAssembly)" Algorithm="SHA256" HashEncoding="hex">
			<Output TaskParameter="Items" ItemName="_BundledPluginHash" />
		</GetFileHash>
		<PropertyGroup>
			<_OfficialPluginSource>
// Generated by GenerateOfficialPluginHashes in ImageScanner.Organizer.csproj
namespace ImageScanner.Organizer.Plugins%3B

internal static class OfficialPluginHashes {
    public static readonly string[] Sha256 = [@(_BundledPluginHash->'"%(FileHash)"', ', ')]%3B
}
</_OfficialPluginSource>
		</PropertyGroup>
		<WriteLinesToFile File="$(IntermediateOutputPath)OfficialPluginHashes.g.cs" Lines="$(_OfficialPluginSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)OfficialPluginHashes.g.cs" />
			<FileWrites Include="$(IntermediateOutputPath)OfficialPluginHashes.g.cs" />
		</ItemGroup>
	</Target>

	<!-- Bundled plugins go next to the app in any other output folder (a runtime-specific build, or a publish) -->
	<Target Name="CopyBundledPluginsToOutput" AfterTargets="Build" Condition="Exists('$(BundledPluginsDir)') and '$([System.IO.Path]::GetFullPath($(OutDir)Plugins\))' != '$(BundledPluginsDir)'">
		<ItemGroup>
			<_BundledPluginFile Include="$(BundledPluginsDir)**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(_BundledPluginFile)" DestinationFiles="@(_BundledPluginFile->'$(OutDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="CopyBundledPluginsToPublish" AfterTargets="Publish" Condition="Exists('$(BundledPluginsDir)')">
		<ItemGroup>
			<_BundledPluginFile Include="$(BundledPluginsDir)**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(_BundledPluginFile)" DestinationFiles="@(_BundledPluginFile->'$(PublishDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>

</Project>
