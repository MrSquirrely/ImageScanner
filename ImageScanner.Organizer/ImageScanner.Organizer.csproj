<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AssemblyTitle>PixShelf</AssemblyTitle>
		<Product>PixShelf</Product>
		<ApplicationIcon>Assets\PixShelf.ico</ApplicationIcon>
		<SixLaborsLicenseFile Condition="Exists('..\sixlabors.lic')">..\sixlabors.lic</SixLaborsLicenseFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="HandyControls" Version="3.7.0" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\PixShelf.ico" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ImageScanner.Core\ImageScanner.Core.csproj" />
		<ProjectReference Include="..\ImageScanner.Plugins.Abstractions\ImageScanner.Plugins.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Bundled plugins: built first so they land in bin\...\Plugins, but never referenced by the app itself -->
		<ProjectReference Include="..\ImageScanner.Plugins.LocalTagger\ImageScanner.Plugins.LocalTagger.csproj" ReferenceOutputAssembly="false" Private="false" />
		<ProjectReference Include="..\ImageScanner.Plugins.Claude\ImageScanner.Plugins.Claude.csproj" ReferenceOutputAssembly="false" Private="false" />
		<!-- The duplicate finder and batch converter are download only (PluginDistribution=Marketplace), so they aren't listed here -->

	</ItemGroup>

	<!--
	  Official plugins: the SHA-256 of each bundled plugin's entry assembly (Plugins\<Name>\<Name>.dll, built above)
	  is compiled into the app. At runtime a plugin is shown as official only if its file matches one of these
	  hashes, so a third-party or modified DLL can't claim to be official by name or author.
	-->
	<Target Name="GenerateOfficialPluginHashes" AfterTargets="ResolveProjectReferences" BeforeTargets="CoreCompile">
		<ItemGroup>
			<_BundledPluginFolder Include="$([System.IO.Directory]::GetDirectories('$(OutDir)Plugins'))" Condition="Exists('$(OutDir)Plugins')" />
			<_BundledPluginAssembly Include="@(_BundledPluginFolder->'%(FullPath)\%(Filename)%(Extension).dll')" />
			<_BundledPluginAssembly Remove="@(_BundledPluginAssembly)" Condition="!Exists('%(FullPath)')" />
		</ItemGroup>
		<GetFileHash Files="@(_BundledPluginAssembly)" Algorithm="SHA256" HashEncoding="hex">
			<Output TaskParameter="Items" ItemName="_BundledPluginHash" />
		</GetFileHash>
		<PropertyGroup>
			<_OfficialPluginSource>
// Generated by GenerateOfficialPluginHashes in ImageScanner.Organizer.csproj
namespace ImageScanner.Organizer.Plugins%3B

internal static class OfficialPluginHashes {
    public static readonly string[] Sha256 = [@(_BundledPluginHash->'"%(FileHash)"', ', ')]%3B
}
</_OfficialPluginSource>
		</PropertyGroup>
		<WriteLinesToFile File="$(IntermediateOutputPath)OfficialPluginHashes.g.cs" Lines="$(_OfficialPluginSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)OfficialPluginHashes.g.cs" />
			<FileWrites Include="$(IntermediateOutputPath)OfficialPluginHashes.g.cs" />
		</ItemGroup>
	</Target>

</Project>
