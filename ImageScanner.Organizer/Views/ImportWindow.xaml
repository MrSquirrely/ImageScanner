<hc:Window x:Class="ImageScanner.Organizer.Views.ImportWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="Import images" Width="560" SizeToContent="Height" ResizeMode="NoResize"
           WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource RegionBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="Scan a folder or an entire drive. Already imported files are skipped unless they changed, and your tags are kept."
                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />

        <TextBlock Text="Folder or drive" FontWeight="SemiBold" Margin="0,16,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Browse…" Click="Browse_Click" AutomationProperties.Name="Browse for folder" />
            <ComboBox x:Name="DriveBox" DockPanel.Dock="Right" Width="90" Margin="6,0,0,0" SelectionChanged="DriveBox_SelectionChanged"
                      hc:InfoElement.Placeholder="Drive" AutomationProperties.Name="Pick a whole drive" />
            <hc:TextBox x:Name="PathBox" hc:InfoElement.Placeholder="C:\Users\me\Pictures" AutomationProperties.Name="Folder path" />
        </DockPanel>

        <TextBlock Text="Skip folders named (separate with ;)" FontWeight="SemiBold" Margin="0,14,0,4" />
        <TextBox x:Name="IgnoredBox" TextWrapping="Wrap" AcceptsReturn="False" AutomationProperties.Name="Folders to skip" />

        <CheckBox x:Name="DetectComicsBox" Margin="0,16,0,0" Content="Group comic pages automatically (folders of numbered pages)" />
        <CheckBox x:Name="SuggestBox" Margin="0,8,0,0" Content="Suggest tags with AI for new images" Checked="SuggestBox_Changed" Unchecked="SuggestBox_Changed" />
        <CheckBox x:Name="AutoApplyBox" Margin="24,8,0,0" Content="Apply suggestions immediately (otherwise review them under &quot;Needs AI review&quot;)" />
        <TextBlock x:Name="AiHint" Margin="24,6,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource WarningBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource ButtonPrimary}" Content="Import" MinWidth="90" IsDefault="True" Click="Import_Click" />
            <Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</hc:Window>
