<hc:Window x:Class="ImageScanner.Organizer.Views.SettingsWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:vm="clr-namespace:ImageScanner.Organizer.ViewModels"
           mc:Ignorable="d"
           d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
           Title="Settings" Width="760" Height="720" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
           Background="{DynamicResource RegionBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16,10" Background="{DynamicResource SecondaryRegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ButtonPrimary}" Content="Save" MinWidth="90" Command="{Binding SaveCommand}" Click="Save_Click" IsDefault="True" />
                <Button Content="Close" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </Border>

        <TabControl Style="{StaticResource TabControlInLine}" Margin="12">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,12">
                        <CheckBox Content="Dark theme" IsChecked="{Binding DarkTheme}" />

                        <TextBlock Text="Library database" FontWeight="SemiBold" Margin="0,18,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Change…" Command="{Binding BrowseLibraryCommand}" />
                            <TextBox Text="{Binding LibraryPath}" IsReadOnly="True" AutomationProperties.Name="Library database path" />
                        </DockPanel>
                        <TextBlock Text="Changing the library file takes effect after restarting." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />

                        <TextBlock Text="Import" FontWeight="SemiBold" Margin="0,18,0,4" />
                        <CheckBox Content="Group comic pages automatically" IsChecked="{Binding DetectComics}" />
                        <TextBlock Text="Skip folders named (separate with ;)" Margin="0,10,0,4" />
                        <TextBox Text="{Binding IgnoredFolders}" TextWrapping="Wrap" AutomationProperties.Name="Folders to skip" />

                        <TextBlock Text="Imported folders" FontWeight="SemiBold" Margin="0,18,0,4" />
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="Remove" Padding="8,0" Height="24"
                                                Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding RootPath, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding ImageCount, Mode=OneWay, StringFormat=' · {0:N0} images'}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <Run Text="{Binding LastScanned, Mode=OneWay, StringFormat=' · scanned {0:g}'}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="AI tagging">
                <StackPanel Margin="8,12">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="AI tagging sends a downscaled copy of each image (max 1024px) to the selected provider and suggests tags, a category and a short description. Providers come from plugins; configure API keys on the Plugins tab." />
                    <TextBlock Text="Provider" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" DisplayMemberPath="DisplayName" AutomationProperties.Name="AI provider" />

                    <TextBlock Text="Maximum tags per image" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <hc:NumericUpDown Value="{Binding MaxSuggestedTags}" Minimum="1" Maximum="50" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Maximum tags per image" />

                    <TextBlock Text="Parallel requests" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <hc:NumericUpDown Value="{Binding AiConcurrency}" Minimum="1" Maximum="16" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Parallel AI requests" />

                    <CheckBox Margin="0,18,0,0" Content="Suggest tags for new images when importing" IsChecked="{Binding SuggestTagsOnImport}" />
                    <CheckBox Margin="0,8,0,0" Content="Apply suggestions immediately instead of queuing them for review" IsChecked="{Binding AutoApplySuggestions}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Plugins">
                <DockPanel Margin="8,12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Open plugins folder" Command="{Binding OpenPluginFolderCommand}" />
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}">
                            <Run Text="Drop plugin folders into" />
                            <Run Text="{Binding PluginFolder, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="and restart. Enabling or disabling a plugin also needs a restart." />
                        </TextBlock>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PluginEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PluginEntryViewModel}">
                                    <Border Margin="0,0,0,10" Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                            Background="{DynamicResource SecondaryRegionBrush}">
                                        <StackPanel>
                                            <DockPanel>
                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleButtonSwitch}" IsChecked="{Binding IsEnabled}"
                                                              AutomationProperties.Name="{Binding Info.Plugin.Name, StringFormat=Enable {0}}" />
                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="14" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Info.Plugin.Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Info.FeatureSummary}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding Info.Source}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding Info.Error}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                                       Visibility="{Binding Info.Error, Converter={StaticResource NullToVisibility}}" />

                                            <ItemsControl ItemsSource="{Binding Settings}" Margin="0,8,0,0" Visibility="{Binding HasSettings, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:PluginSettingViewModel}">
                                                        <StackPanel Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                                                                     Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}"
                                                                     AutomationProperties.Name="{Binding Label}" />
                                                            <hc:PasswordBox IsSafeEnabled="False" UnsafePassword="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                            ShowEyeButton="True" Margin="0,4,0,0"
                                                                            Visibility="{Binding IsSecret, Converter={StaticResource BoolToVisibility}}"
                                                                            AutomationProperties.Name="{Binding Label}" />
                                                            <ToggleButton Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                                          IsChecked="{Binding BoolValue}"
                                                                          Visibility="{Binding IsToggle, Converter={StaticResource BoolToVisibility}}"
                                                                          AutomationProperties.Name="{Binding Label}" />
                                                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" Margin="0,4,0,0" Width="200" HorizontalAlignment="Left"
                                                                      Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}"
                                                                      AutomationProperties.Name="{Binding Label}" />
                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</hc:Window>
