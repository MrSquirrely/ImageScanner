<hc:Window x:Class="ImageScanner.Organizer.Views.SettingsWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:vm="clr-namespace:ImageScanner.Organizer.ViewModels"
           mc:Ignorable="d"
           d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
           Title="Settings" Width="760" Height="720" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
           Background="{DynamicResource RegionBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16,10" Background="{DynamicResource SecondaryRegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ButtonPrimary}" Content="Save" MinWidth="90" Command="{Binding SaveCommand}" Click="Save_Click" IsDefault="True" />
                <Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" ToolTip="Discard changes" />
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" Style="{StaticResource TabControlInLine}" Margin="12" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="General">
                <DockPanel Margin="8,12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Run setup wizard again" Command="{Binding RerunSetupCommand}"
                                ToolTip="Shows the first-run wizard the next time the app starts" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Select a setting to see what it does. Changes apply when you click Save." />
                    </DockPanel>
                    <!-- Rows come from SettingsSheet's Category / DisplayName / Description attributes -->
                    <hc:PropertyGrid SelectedObject="{Binding Sheet}" MinTitleWidth="220" MaxTitleWidth="260"
                                     AutomationProperties.Name="Settings" />
                </DockPanel>
            </TabItem>

            <TabItem Header="Imported folders">
                <DockPanel Margin="8,12">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Folders and drives you've imported. Rescan checks all of them; remove one to stop rescanning it." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sources}" AutomationProperties.Name="Imported folders">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="Remove" Padding="8,0" Height="24"
                                                Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding RootPath, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding ImageCount, Mode=OneWay, StringFormat=' · {0:N0} images'}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <Run Text="{Binding LastScanned, Mode=OneWay, StringFormat=' · scanned {0:g}'}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Plugins">
                <DockPanel Margin="8,12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Open plugins folder" Command="{Binding OpenPluginFolderCommand}" />
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}">
                            <Run Text="Drop plugin folders into" />
                            <Run Text="{Binding PluginFolder, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="and restart. Enabling or disabling a plugin also needs a restart." />
                        </TextBlock>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding PluginEntries}" ItemTemplate="{StaticResource PluginCardTemplate}" AutomationProperties.Name="Installed plugins">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="MarketplaceTab" Header="Marketplace">
                <!-- Listings come from the repository's GitHub Discussions; each "… Plugins" category is a filter -->
                <DockPanel Margin="8,12" DataContext="{Binding Marketplace}">
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Command="{Binding ShareCommand}" Style="{StaticResource ButtonPrimary}"
                                ToolTip="Post your plugin in the PixShelf GitHub Discussions" AutomationProperties.Name="Share a plugin">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE898;" Margin="0,0,6,0" />
                                <TextBlock Text="Share a plugin" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Command="{Binding OpenDiscussionsCommand}" Content="Open on GitHub"
                                AutomationProperties.Name="Open the marketplace on GitHub" />
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,0" Command="{Binding RefreshCommand}" ToolTip="Refresh"
                                AutomationProperties.Name="Refresh marketplace">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
                        </Button>
                        <hc:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="Search plugins"
                                    hc:InfoElement.ShowClearButton="True" AutomationProperties.Name="Search plugins" />
                    </DockPanel>

                    <ListBox DockPanel.Dock="Top" Margin="0,10,0,0" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Plugin categories">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemBaseStyle}">
                                <Setter Property="Margin" Value="0,0,6,6" />
                                <Setter Property="Padding" Value="12,4" />
                                <Setter Property="hc:BorderElement.CornerRadius" Value="14" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" ToolTip="{Binding Category.Description}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,6" CornerRadius="4" BorderThickness="1"
                            BorderBrush="{DynamicResource WarningBrush}" Visibility="{Binding Warning, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
                    </Border>

                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LastUpdated}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Community plugins aren't reviewed by the PixShelf team. Check the discussion and source before installing." />
                    </DockPanel>

                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Listings}" AutomationProperties.Name="Marketplace plugins">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MarketplaceListingViewModel}">
                                        <Border Width="336" Height="196" Margin="0,0,10,10" Padding="14" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SecondaryRegionBrush}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Top">
                                                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0" Background="{DynamicResource RegionBrush}"
                                                            ToolTip="{Binding Listing.Author}">
                                                        <Border.OpacityMask>
                                                            <VisualBrush>
                                                                <VisualBrush.Visual>
                                                                    <Ellipse Width="36" Height="36" Fill="Black" />
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Border.OpacityMask>
                                                        <Image Source="{Binding Listing.AuthorAvatarUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Top" FontSize="11" Text="{Binding CategoryLabel}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="190" ToolTip="{Binding Name}" />
                                                            <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="8" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"
                                                                    Visibility="{Binding Listing.IsTeamPost, Converter={StaticResource BoolToVisibility}}"
                                                                    ToolTip="Posted by the PixShelf team">
                                                                <TextBlock Text="Team" FontSize="10" Foreground="White" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Byline}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource ButtonPrimary}" Content="{Binding ActionText}" Command="{Binding InstallCommand}"
                                                            Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}"
                                                            AutomationProperties.Name="{Binding ActionName}" />
                                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0" Text="{Binding StateText}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <Button DockPanel.Dock="Left" Padding="8,0" Command="{Binding OpenCommand}" ToolTip="Open the discussion on GitHub"
                                                            AutomationProperties.Name="{Binding Name, StringFormat=Details for {0}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Listing.Likes, StringFormat=👍 {0}}" ToolTip="Thumbs-up reactions on GitHub" />
                                                            <TextBlock Margin="10,0,0,0" Text="{Binding Listing.Comments, StringFormat=💬 {0}}" ToolTip="Comments" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button DockPanel.Dock="Left" Margin="6,0,0,0" Padding="8,0" Command="{Binding OpenSourceCommand}" Content="Source"
                                                            Visibility="{Binding Listing.SourceUrl, Converter={StaticResource NullToVisibility}}"
                                                            AutomationProperties.Name="{Binding Name, StringFormat=Source code for {0}}" />
                                                </DockPanel>

                                                <TextBlock Margin="0,10,0,8" Text="{Binding Listing.Summary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Listing.Summary}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <hc:LoadingCircle HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                                    Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE719;" FontSize="36" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Margin="0,10,0,0" Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</hc:Window>
