<hc:Window x:Class="ImageScanner.Organizer.Views.FirstRunWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:vm="clr-namespace:ImageScanner.Organizer.ViewModels"
           mc:Ignorable="d"
           d:DataContext="{d:DesignInstance vm:FirstRunViewModel}"
           Title="Welcome to Image Organizer" Width="780" Height="620" ResizeMode="NoResize"
           WindowStartupLocation="CenterScreen" Background="{DynamicResource RegionBrush}">
    <DockPanel>
        <hc:StepBar DockPanel.Dock="Top" Margin="24,20,24,8" ItemsSource="{Binding Steps}" StepIndex="{Binding StepIndex}"
                    AutomationProperties.Name="Setup progress" />

        <Border DockPanel.Dock="Bottom" Padding="20,12" Background="{DynamicResource SecondaryRegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Skip setup" Command="{Binding SkipCommand}" Style="{StaticResource ButtonDefault}"
                        ToolTip="Use the default settings; you can change everything later in Settings" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Back" MinWidth="90" Command="{Binding BackCommand}"
                            IsEnabled="{Binding IsFirstStep, Converter={StaticResource InverseBool}}" />
                    <Button Margin="8,0,0,0" MinWidth="110" Command="{Binding NextCommand}" IsDefault="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                                <Setter Property="Content" Value="Next" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                        <Setter Property="Content" Value="Finish" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="40,16,40,16">
            <!-- 0: Welcome -->
            <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                <TextBlock Text="Welcome!" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="14"
                           Text="Image Organizer scans your folders and drives into a searchable library. Tag and categorize images, group comic pages into readable comics, and let AI suggest tags for you." />
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="This short setup picks a few preferences. Everything can be changed later under Settings." />
                <CheckBox Margin="0,28,0,0" Content="Use the dark theme" IsChecked="{Binding DarkTheme}" FontSize="14" />
            </StackPanel>

            <!-- 1: Library -->
            <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
                <TextBlock Text="Where should your library live?" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="The library is a single database file holding tags, categories, comics and thumbnails. Your images are never moved or modified." />
                <DockPanel Margin="0,20,0,0">
                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Change…" Command="{Binding BrowseLibraryCommand}" />
                    <TextBox Text="{Binding LibraryPath}" AutomationProperties.Name="Library database location" />
                </DockPanel>
            </StackPanel>

            <!-- 2: AI tagging -->
            <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}">
                <TextBlock Text="AI tag suggestions" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Claude can look at each image and suggest tags, a category and a short description. A downscaled copy of each image is sent to Anthropic, and each image is one paid API request." />
                <CheckBox Margin="0,18,0,0" Content="Use AI tag suggestions (Claude)" IsChecked="{Binding EnableAi}" FontSize="14" />
                <StackPanel Margin="24,10,0,0" IsEnabled="{Binding EnableAi}">
                    <TextBlock Text="Anthropic API key" FontWeight="SemiBold" />
                    <hc:PasswordBox Margin="0,4,0,0" IsSafeEnabled="False" ShowEyeButton="True"
                                    UnsafePassword="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Anthropic API key" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Stored encrypted for your Windows account. Get a key at console.anthropic.com. You can also add it later." />
                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Text="ANTHROPIC_API_KEY is set; it will be used if you leave this empty."
                               Visibility="{Binding HasEnvironmentKey, Converter={StaticResource BoolToVisibility}}" />
                    <CheckBox Margin="0,14,0,0" Content="Suggest tags automatically for newly imported images" IsChecked="{Binding SuggestOnImport}" />
                    <CheckBox Margin="0,8,0,0" Content="Apply suggestions immediately (otherwise review them first)" IsChecked="{Binding AutoApply}" />
                </StackPanel>
            </StackPanel>

            <!-- 3: Viewing -->
            <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}">
                <TextBlock Text="How should images open?" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Choose what happens when you double-click an image. Comics always open in the built-in reader." />
                <RadioButton Margin="0,20,0,0" GroupName="Viewer" IsChecked="{Binding UseBuiltInViewer}" FontSize="14"
                             Content="Built-in viewer — zoom, pan and browse through results with the arrow keys" />
                <RadioButton Margin="0,12,0,0" GroupName="Viewer" IsChecked="{Binding UseSystemViewer}" FontSize="14"
                             Content="My computer's default image app (e.g. Photos)" />
            </StackPanel>

            <!-- 4: Plugins -->
            <DockPanel Visibility="{Binding StepIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=4}">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Plugins" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,10" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Plugins add features such as other AI taggers, menu actions and import steps. Choose which ones to turn on." />
                </StackPanel>
                <ContentPresenter DockPanel.Dock="Bottom" Margin="0,10,0,0" ContentTemplate="{StaticResource MarketplaceComingSoon}" Content="{Binding}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Plugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WizardPluginItem}">
                                <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleButtonSwitch}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding Name, StringFormat=Enable {0}}" />
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Source, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- 5: Finish -->
            <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=5}">
                <TextBlock Text="You're all set" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="14"
                           Text="Next, import a folder (or a whole drive) to build your library. You can import more folders at any time with the Import button." />
                <CheckBox Margin="0,24,0,0" Content="Choose a folder to import when I click Finish" IsChecked="{Binding ImportAfterSetup}" FontSize="14" />
            </StackPanel>
        </Grid>
    </DockPanel>
</hc:Window>
