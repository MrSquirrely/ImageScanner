<Application x:Class="ImageScanner.Organizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ImageScanner.Organizer.Converters"
             xmlns:vm="clr-namespace:ImageScanner.Organizer.ViewModels"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is swapped between SkinDefault and SkinDark by App.ApplyTheme -->
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:IndexToVisibilityConverter x:Key="IndexToVisibility" />
            <conv:BoolRadioConverter x:Key="BoolRadio" />

            <!-- HandyControl centers radio buttons by default; settings lists read better left-aligned -->
            <Style x:Key="OptionRadio" TargetType="RadioButton" BasedOn="{StaticResource RadioButtonBaseStyle}">
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <!-- Editor for one plugin setting (text, secret, toggle or choice); used by Settings and the first-run wizard -->
            <DataTemplate x:Key="PluginSettingTemplate" DataType="{x:Type vm:PluginSettingViewModel}">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                             Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="{Binding Label}" />
                    <hc:PasswordBox IsSafeEnabled="False" UnsafePassword="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ShowEyeButton="True" Margin="0,4,0,0"
                                    Visibility="{Binding IsSecret, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="{Binding Label}" />
                    <ToggleButton Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                  IsChecked="{Binding BoolValue}"
                                  Visibility="{Binding IsToggle, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.Name="{Binding Label}" />
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" Margin="0,4,0,0" Width="200" HorizontalAlignment="Left"
                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}"
                              AutomationProperties.Name="{Binding Label}" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </DataTemplate>

            <!-- Shared "coming soon" card for the plugin marketplace (wizard + settings) -->
            <DataTemplate x:Key="MarketplaceComingSoon">
                <Border Padding="16" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SecondaryRegionBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE719;" FontSize="28" Margin="0,0,14,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Plugin marketplace" FontWeight="SemiBold" FontSize="14" />
                                <Border Margin="8,0,0,0" Padding="8,1" CornerRadius="9" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="Coming soon" Foreground="White" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Browse and install community plugins in one click. Until then, drop plugin folders into the Plugins folder and restart." />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </DataTemplate>

            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <Style x:Key="IconText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="Margin" Value="12,14,12,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
