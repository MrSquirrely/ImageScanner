<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Lets the organizer's PluginLoadContext resolve this plugin's own dependencies -->
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<PluginOutputDir>$(MSBuildThisFileDirectory)..\ImageScanner.Organizer\bin\$(Configuration)\net10.0-windows\Plugins\$(MSBuildProjectName)\</PluginOutputDir>
	</PropertyGroup>

	<ItemGroup>
		<!-- Contracts are provided by the host at runtime; don't ship copies -->
		<ProjectReference Include="..\ImageScanner.Plugins.Abstractions\ImageScanner.Plugins.Abstractions.csproj">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
	</ItemGroup>

	<!-- Drop the built plugin into the organizer's Plugins folder so F5 picks it up -->
	<Target Name="CopyToOrganizerPlugins" AfterTargets="Build">
		<ItemGroup>
			<PluginFiles Include="$(OutDir)$(TargetName).dll;$(OutDir)$(TargetName).pdb;$(OutDir)$(TargetName).deps.json" />
		</ItemGroup>
		<Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginOutputDir)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
	</Target>

</Project>
