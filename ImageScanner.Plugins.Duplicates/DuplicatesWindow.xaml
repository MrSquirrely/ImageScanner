<hc:Window x:Class="ImageScanner.Plugins.Duplicates.DuplicatesWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:local="clr-namespace:ImageScanner.Plugins.Duplicates"
           Title="Duplicate finder" Width="1040" Height="780" MinWidth="720" MinHeight="480"
           WindowStartupLocation="CenterOwner" Background="{DynamicResource RegionBrush}">
    <DockPanel>
        <!-- Options -->
        <Border DockPanel.Dock="Top" Padding="14,10" Background="{DynamicResource SecondaryRegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="ScanButton" DockPanel.Dock="Right" Style="{StaticResource ButtonPrimary}" Click="Scan_Click" AutomationProperties.Name="Scan for duplicates">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Scan" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Compare by" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="AlgorithmBox" Width="290" AutomationProperties.Name="Comparison method" />
                    <TextBlock Text="Minimum similarity" VerticalAlignment="Center" Margin="18,0,8,0" />
                    <Slider x:Name="SimilaritySlider" Width="160" Minimum="80" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" AutomationProperties.Name="Minimum similarity" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40"
                               Text="{Binding Value, ElementName=SimilaritySlider, StringFormat={}{0:0} %}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Progress and scope -->
        <StackPanel DockPanel.Dock="Top" Margin="14,10,14,0">
            <DockPanel x:Name="ProgressPanel" Visibility="Collapsed">
                <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
                <ProgressBar x:Name="Progress" Height="8" Style="{StaticResource ProgressBarFlat}" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel x:Name="FocusPanel" Visibility="Collapsed" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Show all duplicates" Click="ShowAll_Click" />
                <TextBlock x:Name="FocusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>

        <!-- Actions -->
        <Border DockPanel.Dock="Bottom" Padding="14,10" Background="{DynamicResource SecondaryRegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="DeleteButton" Style="{StaticResource ButtonDanger}" IsEnabled="False" Click="Delete_Click"
                            AutomationProperties.Name="Send selected to the Recycle Bin">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74D;" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Send selected to Recycle Bin" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Content="Close" IsCancel="True" Click="Close_Click" />
                </StackPanel>
                <Button DockPanel.Dock="Left" Content="Select all but the best" Click="SelectExtras_Click"
                        ToolTip="In every group, select everything except the copy with the most pixels (then the biggest file)" />
                <Button DockPanel.Dock="Left" Margin="8,0,0,0" Content="Clear selection" Click="ClearSelection_Click" />
                <TextBlock x:Name="SelectionText" Margin="14,0,0,0" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,8">
                <ItemsControl x:Name="GroupList" AutomationProperties.Name="Duplicate groups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:GroupView}">
                            <Border Margin="0,0,0,12" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource SecondaryRegionBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:DuplicateItem}">
                                                <Border Width="176" Margin="0,0,10,4" Padding="8" CornerRadius="6" BorderThickness="2" Background="{DynamicResource RegionBrush}"
                                                        ToolTip="{Binding Path}" AutomationProperties.Name="{Binding FileName}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Delete}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Grid Height="130">
                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Padding="6,1" CornerRadius="8"
                                                                    Background="{DynamicResource SuccessBrush}" ToolTip="Most pixels in this group"
                                                                    Visibility="{Binding BestVisibility}">
                                                                <TextBlock Text="Best" FontSize="10" Foreground="White" />
                                                            </Border>
                                                        </Grid>
                                                        <CheckBox Margin="0,6,0,0" Content="Delete" IsChecked="{Binding Delete}"
                                                                  AutomationProperties.Name="{Binding FileName, StringFormat=Delete {0}}" />
                                                        <TextBlock Margin="0,4,0,0" Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        <TextBlock Text="{Binding Folder}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                       FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</hc:Window>
