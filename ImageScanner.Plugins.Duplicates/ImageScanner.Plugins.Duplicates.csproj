<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>ImageScanner.Plugins.Duplicates</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- Perceptual hashing (Apache-2.0). Its ImageSharp transformer package targets ImageSharp 3, so this plugin
		     implements IImageTransformer on the ImageSharp 4 the app shares with plugins instead. -->
		<PackageReference Include="DuplaImage.Lib" Version="1.3.0" />
		<!-- Compile-time only: at runtime the window uses the app's copy of HandyControls -->
		<PackageReference Include="HandyControls" Version="3.7.0" ExcludeAssets="runtime" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- WPF projects leave System.IO out of the implicit usings -->
		<Using Include="System.IO" />
	</ItemGroup>

	<Import Project="..\build\Plugin.targets" />

</Project>
