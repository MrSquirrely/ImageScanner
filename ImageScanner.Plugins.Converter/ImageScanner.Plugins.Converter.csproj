<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>ImageScanner.Plugins.Converter</RootNamespace>
		<!-- Download only: published to the Marketplace, not shipped with the app -->
		<PluginDistribution>Marketplace</PluginDistribution>
	</PropertyGroup>

	<ItemGroup>
		<!-- ImageMagick (Apache-2.0) encodes AVIF and JPEG XL, which ImageSharp can't, as well as WebP, JPEG and PNG -->
		<PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" />
		<!-- Compile-time only: at runtime the window uses the app's copy of HandyControls -->
		<PackageReference Include="HandyControls" Version="3.7.0" ExcludeAssets="runtime" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- WPF projects leave System.IO out of the implicit usings -->
		<Using Include="System.IO" />
	</ItemGroup>

	<Import Project="..\build\Plugin.targets" />

</Project>
