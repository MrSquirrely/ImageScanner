<Window x:Class="ImageScanner.Plugins.Viewer.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media viewer" Width="1100" Height="760" MinWidth="560" MinHeight="360"
        Background="#111111" Foreground="#F2F2F2" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="BarBrush" Color="#1C1C1C" />
        <SolidColorBrush x:Key="HoverBrush" Color="#333333" />
        <SolidColorBrush x:Key="ActiveBrush" Color="#326CF3" />

        <Style x:Key="BarButton" TargetType="ButtonBase">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ActiveBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="Viewport" Background="#111111" ClipToBounds="True" SizeChanged="Viewport_SizeChanged"
                MouseWheel="Viewport_MouseWheel" MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                MouseLeftButtonUp="Viewport_MouseLeftButtonUp" MouseMove="Viewport_MouseMove">
            <Grid>
                <!-- A Canvas doesn't clip its children: in a Grid the full-size picture is cut to the viewport before it's scaled -->
                <Canvas>
                    <Image x:Name="Picture" Stretch="Fill">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="PictureScale" />
                                <TranslateTransform x:Name="PictureOffset" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Canvas>
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" ScrubbingEnabled="True"
                              Visibility="Collapsed" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed" />
                <StackPanel x:Name="MessagePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="520">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" TextAlignment="Center" Foreground="#D0D0D0" FontSize="14" />
                    <Button x:Name="OpenExternallyButton" Content="Open in the default app" Margin="0,14,0,0" Padding="14,6" HorizontalAlignment="Center"
                            Click="OpenExternally_Click" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource BarBrush}" Padding="8,6">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource BarButton}" Content="&#xE76B;" Click="Previous_Click" ToolTip="Previous (Left)" AutomationProperties.Name="Previous" />
                    <Button Style="{StaticResource BarButton}" Content="&#xE76C;" Click="Next_Click" ToolTip="Next (Right)" AutomationProperties.Name="Next" />
                    <TextBlock x:Name="CounterText" Style="{StaticResource BarText}" AutomationProperties.Name="Position in list" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="ZoomText" Style="{StaticResource BarText}" MinWidth="44" TextAlignment="Right" AutomationProperties.Name="Zoom" />
                    <Button x:Name="FitButton" Style="{StaticResource BarButton}" Content="&#xE9A6;" Click="Fit_Click" ToolTip="Fit to window (0)" AutomationProperties.Name="Fit to window" />
                    <Button x:Name="ActualSizeButton" Style="{StaticResource BarButton}" Content="1:1" FontFamily="Segoe UI" FontSize="12" Click="ActualSize_Click"
                            ToolTip="Actual size (1)" AutomationProperties.Name="Actual size" />
                    <Button x:Name="RotateButton" Style="{StaticResource BarButton}" Content="&#xE7AD;" Click="Rotate_Click" ToolTip="Rotate (R)" AutomationProperties.Name="Rotate" />
                    <ToggleButton x:Name="SlideshowButton" Style="{StaticResource BarButton}" Content="&#xE786;" Click="Slideshow_Click" ToolTip="Slideshow (S)"
                                  AutomationProperties.Name="Slideshow" />
                    <Button Style="{StaticResource BarButton}" Content="&#xE740;" Click="FullScreen_Click" ToolTip="Full screen (F11)" AutomationProperties.Name="Full screen" />
                </StackPanel>

                <!-- Shown for videos and animations -->
                <DockPanel x:Name="PlaybackPanel" Margin="12,0" Visibility="Collapsed">
                    <Button x:Name="PlayButton" DockPanel.Dock="Left" Style="{StaticResource BarButton}" Content="&#xE769;" Click="Play_Click" ToolTip="Play or pause (Space)"
                            AutomationProperties.Name="Play or pause" />
                    <StackPanel x:Name="SoundPanel" DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton x:Name="LoopButton" Style="{StaticResource BarButton}" Content="&#xE8EE;" Click="Loop_Click" ToolTip="Loop (L)" AutomationProperties.Name="Loop" />
                        <ToggleButton x:Name="MuteButton" Style="{StaticResource BarButton}" Content="&#xE767;" Click="Mute_Click" ToolTip="Mute (M)" AutomationProperties.Name="Mute" />
                        <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center" Focusable="False" IsMoveToPointEnabled="True"
                                ValueChanged="Volume_ValueChanged" AutomationProperties.Name="Volume" />
                    </StackPanel>
                    <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Style="{StaticResource BarText}" AutomationProperties.Name="Playback position" />
                    <Slider x:Name="SeekSlider" VerticalAlignment="Center" Focusable="False" IsMoveToPointEnabled="True" ValueChanged="Seek_ValueChanged"
                            AutomationProperties.Name="Seek" />
                </DockPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>